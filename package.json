{
  "name": "shadewise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src tests",
    "test": "vitest run --passWithNoTests",
    "build:widget": "rm -rf public/widget && esbuild src/widget/index.ts --bundle --minify --format=esm --splitting --target=es2020 --outdir=public/widget --chunk-names=chunks/[name]-[hash]",
    "prebuild": "npm run setup:mediapipe && npm run build:widget",
    "setup:mediapipe": "node scripts/setup-mediapipe.mjs",
    "predev": "npm run setup:mediapipe && npm run build:widget",
    "fairness:report": "tsx scripts/fairness-report.ts",
    "sample:record": "tsx scripts/record-sample.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.1.0",
    "next": "^16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "24.x"
  }
}
